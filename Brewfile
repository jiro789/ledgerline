# Machine-level prerequisites for Ledgerline.
# `brew bundle` must be sufficient to bootstrap a machine from a fresh clone.
# Project dependencies are pinned in the repo: go.mod, uv.lock, docker-compose.yml.
# Add tools by hand — `brew bundle dump` captures the whole machine and drifts.

brew "go"
brew "colima"
brew "docker"
brew "gh"
brew "temporal"
brew "ollama"
brew "uv"
